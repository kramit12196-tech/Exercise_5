/* עיצוב החלון הראשי של סימולציית מעבר החום */
#mainWindow {
    background-color: #E9EDF2;
    font-family: "Segoe UI";
    color: #23364D;
}

#mainWindow QLabel {
    color: #23364D;
    background-color: transparent;
    font-family: "Segoe UI";
}

/* כותרת ראשית כהה */
#headerCard {
    background-color: #23364D;
    border-radius: 8px;
}

#mainWindow QLabel#headerTitle {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
}

#mainWindow QLabel#headerSubtitle {
    color: #CBD5E1;
    font-size: 12px;
}

#mainWindow QPushButton#aboutButton {
    background-color: transparent;
    color: #FFFFFF;
    border: 1px solid #94A3B8;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
}

#mainWindow QPushButton#aboutButton:hover {
    background-color: #2F4663;
    border: 1px solid #FFFFFF;
}

#mainWindow QPushButton#aboutButton:pressed {
    background-color: #1B2A3D;
}

/* כרטיסי תוכן לבנים */
#thermalCard,
#body1Card,
#controlsCard,
#body2Card {
    background-color: #FFFFFF;
    border: 1px solid #E3E8EE;
    border-radius: 10px;
}

/* כותרות כרטיסים ומפרידים */
#mainWindow QLabel#sectionTitle {
    color: #23364D;
    font-size: 15px;
    font-weight: bold;
}

#mainWindow QLabel#cardTitle {
    color: #23364D;
    font-size: 15px;
    font-weight: bold;
}

#mainWindow QWidget#dividerLine {
    background-color: #E3E8EE;
}

/* תווית מצב הסימולציה */
#mainWindow QLabel#statusLabel {
    color: #64748B;
    background-color: #F1F5F9;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 600;
}

/* כותרות ותוויות משניות */
#mainWindow QLabel#bodyTitle {
    color: #23364D;
    font-size: 14px;
    font-weight: bold;
}

#mainWindow QLabel#secondaryLabel {
    color: #64748B;
    font-size: 12px;
    font-weight: 600;
}

#mainWindow QLabel#paramLabel {
    color: #23364D;
    font-size: 13px;
}

/* מלבני הגופים והמוט המחבר */
#mainWindow QLabel#bodyVisual {
    color: #FFFFFF;
    font-size: 21px;
    font-weight: bold;
    border-radius: 6px;
}

#mainWindow QLabel#connectorRod {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #94A3B8,
        stop: 0.5 #CBD5E1,
        stop: 1 #94A3B8
    );
    border-top: 1px solid #94A3B8;
    border-bottom: 1px solid #94A3B8;
}

/* חיווי גופי חימום */
#mainWindow QLabel#heaterIndicator {
    background-color: #E2E8F0;
    color: #475569;
    border: 1px solid #CBD5E1;
    border-radius: 13px;
    font-size: 11px;
    font-weight: 600;
}

/* תצוגת קצב מעבר חום מתחת למוט המחבר */
#mainWindow QLabel#heatRateTitle {
    color: #64748B;
    font-size: 11px;
    font-weight: 600;
}

#mainWindow QLabel#heatRateValue {
    color: #23364D;
    font-size: 19px;
    font-weight: bold;
}

#mainWindow QLabel#heatRateStrength {
    color: #64748B;
    font-size: 11px;
    font-weight: 600;
}

/* תצוגות לקריאה בלבד */
#mainWindow QLabel#tempDisplay {
    background-color: #E2E8F0;
    color: #23364D;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
}

#mainWindow QLabel#tempTrend {
    color: #94A3B8;
    background-color: transparent;
    font-size: 19px;
    font-weight: bold;
}

#mainWindow QLabel#timeDisplay {
    background-color: #F1F5F9;
    color: #23364D;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    font-size: 21px;
    font-weight: bold;
}

/* שדות קלט מספריים */
#mainWindow QDoubleSpinBox {
    background-color: #F8FAFC;
    color: #23364D;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 0px 4px;
    font-size: 13px;
    font-family: "Segoe UI";
}

#mainWindow QDoubleSpinBox:focus {
    border: 2px solid #2871B8;
    background-color: #FFFFFF;
}

#mainWindow QDoubleSpinBox:disabled {
    background-color: #EDF1F5;
    color: #94A3B8;
    border: 1px solid #E3E8EE;
}

#mainWindow QDoubleSpinBox::up-button,
#mainWindow QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 0px;
    border: none;
}

/* תיבות בחירה */
#mainWindow QComboBox {
    background-color: #F8FAFC;
    color: #23364D;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 13px;
    font-family: "Segoe UI";
}

#mainWindow QComboBox:focus {
    border: 2px solid #2871B8;
    background-color: #FFFFFF;
}

#mainWindow QComboBox:disabled {
    background-color: #EDF1F5;
    color: #94A3B8;
    border: 1px solid #E3E8EE;
}

/* סליידרים אנכיים לטמפרטורה */
#mainWindow QSlider::groove:vertical {
    background-color: #CBD5E1;
    width: 6px;
    border-radius: 3px;
}

#mainWindow QSlider::sub-page:vertical {
    background-color: #CBD5E1;
    border-radius: 3px;
}

#mainWindow QSlider::add-page:vertical {
    background-color: #2871B8;
    border-radius: 3px;
}

#mainWindow QSlider::handle:vertical {
    background-color: #2871B8;
    border: 2px solid #FFFFFF;
    height: 16px;
    width: 16px;
    margin: 0px -6px;
    border-radius: 9px;
}

#mainWindow QSlider::handle:vertical:hover {
    background-color: #2364A3;
}

#mainWindow QSlider::handle:vertical:disabled {
    background-color: #94A3B8;
}

/* כפתור הפעלה ועצירה ראשי */
#mainWindow QPushButton#startButton {
    background-color: #2871B8;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
}

#mainWindow QPushButton#startButton:hover {
    background-color: #2364A3;
}

#mainWindow QPushButton#startButton:pressed {
    background-color: #1C5489;
}

#mainWindow QPushButton#startButton:checked {
    background-color: #DC2626;
    color: #FFFFFF;
}

#mainWindow QPushButton#startButton:checked:hover {
    background-color: #B91C1C;
}

#mainWindow QPushButton#startButton:disabled {
    background-color: #EDF1F5;
    color: #94A3B8;
    border: 1px solid #CBD5E1;
}

/* כפתורים משניים */
#mainWindow QPushButton#secondaryButton {
    background-color: #FFFFFF;
    color: #23364D;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
}

#mainWindow QPushButton#secondaryButton:hover {
    background-color: #F1F5F9;
    border: 1px solid #94A3B8;
}

#mainWindow QPushButton#secondaryButton:pressed {
    background-color: #E2E8F0;
}

/* Graph window styling */
#graphWindow {
    background-color: #E9EDF2;
    font-family: "Segoe UI";
    color: #23364D;
}

#graphWindow QLabel {
    color: #23364D;
    background-color: transparent;
    font-family: "Segoe UI";
}

#graphHeaderCard {
    background-color: #23364D;
    border-radius: 8px;
}

#graphWindow QLabel#headerTitle {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
}

#graphWindow QLabel#headerSubtitle {
    color: #CBD5E1;
    font-size: 12px;
}

#graphPlotCard,
#graphControlsCard,
#graphTableCard {
    background-color: #FFFFFF;
    border: 1px solid #E3E8EE;
    border-radius: 10px;
}

#graphWindow QLabel#sectionTitle,
#graphWindow QLabel#cardTitle {
    color: #23364D;
    font-size: 15px;
    font-weight: bold;
}

#graphWindow QLabel#secondaryLabel {
    color: #64748B;
    font-size: 12px;
    font-weight: 600;
}

#graphWindow QWidget#dividerLine {
    background-color: #E3E8EE;
}

#graphWindow QComboBox {
    background-color: #F8FAFC;
    color: #23364D;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 2px 10px;
    font-size: 13px;
    font-family: "Segoe UI";
}

#graphWindow QComboBox:focus {
    border: 2px solid #2871B8;
    background-color: #FFFFFF;
}

#graphWindow QComboBox:disabled {
    background-color: #EDF1F5;
    color: #94A3B8;
    border: 1px solid #E3E8EE;
}

#graphWindow QPushButton#drawButton {
    background-color: #2871B8;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
}

#graphWindow QPushButton#drawButton:hover {
    background-color: #2364A3;
}

#graphWindow QPushButton#drawButton:pressed {
    background-color: #1C5489;
}

#graphWindow QPushButton#drawButton:disabled {
    background-color: #EDF1F5;
    color: #94A3B8;
    border: 1px solid #CBD5E1;
}

#graphWindow QPushButton#graphSecondaryButton {
    background-color: #FFFFFF;
    color: #23364D;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
}

#graphWindow QPushButton#graphSecondaryButton:hover {
    background-color: #F1F5F9;
    border: 1px solid #94A3B8;
}

#graphWindow QPushButton#graphSecondaryButton:pressed {
    background-color: #E2E8F0;
}

#graphWindow QPushButton#toggleTableButton {
    background-color: #F8FAFC;
    color: #23364D;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
}

#graphWindow QPushButton#toggleTableButton:hover {
    background-color: #F1F5F9;
    border: 1px solid #94A3B8;
}

#graphWindow QPushButton#toggleTableButton:pressed {
    background-color: #E2E8F0;
}

/* Simulation parameters table */
#graphWindow QTableWidget#parametersTable {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    color: #23364D;
    gridline-color: #E3E8EE;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    font-size: 13px;
    font-family: "Segoe UI";
    selection-background-color: #DBEAFE;
    selection-color: #23364D;
}

#graphWindow QTableWidget#parametersTable::item {
    padding: 0px;
}

#graphWindow QHeaderView {
    background-color: #23364D;
    border: none;
}

#graphWindow QHeaderView::section {
    background-color: #23364D;
    color: #FFFFFF;
    border: none;
    border-right: 1px solid #334A66;
    padding: 5px 8px;
    font-size: 13px;
    font-weight: bold;
}

/* Parameter table category cells and group separators */
#graphWindow QLabel#categoryGeneral {
    background-color: #E7EDF5;
    color: #23364D;
    font-size: 13px;
    font-weight: bold;
    border-left: 4px solid #64748B;
    border-bottom: 2px solid #94A3B8;
}

#graphWindow QLabel#categoryBody1 {
    background-color: #FBE9E9;
    color: #B91C1C;
    font-size: 13px;
    font-weight: bold;
    border-left: 4px solid #DC2626;
    border-bottom: 2px solid #94A3B8;
}

#graphWindow QLabel#categoryBody2 {
    background-color: #E8F0FA;
    color: #215B99;
    font-size: 13px;
    font-weight: bold;
    border-left: 4px solid #2871B8;
}

#graphWindow QLabel#tableSeparatorParam {
    background-color: transparent;
    color: #23364D;
    font-size: 13px;
    padding: 0px 2px;
    border-bottom: 2px solid #94A3B8;
}

#graphWindow QLabel#tableSeparatorValue {
    background-color: transparent;
    color: #23364D;
    font-size: 13px;
    padding: 0px;
    border-bottom: 2px solid #94A3B8;
}

/* Matplotlib navigation toolbar */
#graphWindow QToolBar#graphToolbar {
    background-color: #F8FAFC;
    color: #23364D;
    border: 1px solid #E3E8EE;
    border-radius: 6px;
    spacing: 4px;
    padding: 1px 6px;
}

#graphWindow QToolBar#graphToolbar QToolButton {
    background-color: transparent;
    color: #23364D;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 2px;
}

#graphWindow QToolBar#graphToolbar QToolButton:hover {
    background-color: #E2E8F0;
    border: 1px solid #CBD5E1;
}

#graphWindow QToolBar#graphToolbar QToolButton:pressed {
    background-color: #CBD5E1;
}

#graphWindow QToolBar#graphToolbar QToolButton:checked {
    background-color: #DBEAFE;
    border: 1px solid #2871B8;
}

#graphWindow QToolBar#graphToolbar QToolButton:disabled {
    background-color: transparent;
    border: 1px solid transparent;
}

#graphWindow QToolBar#graphToolbar QLabel {
    color: #64748B;
    font-size: 11px;
    padding-right: 6px;
}

/* Browser-style graph tabs */
#graphWindow QTabWidget#graphTabs::pane {
    background-color: #FFFFFF;
    border: 1px solid #E3E8EE;
    border-top-left-radius: 0px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    top: -1px;
}

#graphWindow QTabWidget#graphTabs QTabBar::tab {
    background-color: #DCE4ED;
    color: #64748B;
    border: 1px solid #CBD5E1;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 18px;
    margin-right: 4px;
    font-size: 13px;
    font-weight: 600;
    font-family: "Segoe UI";
}

#graphWindow QTabWidget#graphTabs QTabBar::tab:hover:!selected {
    background-color: #E8EEF5;
    color: #23364D;
}

#graphWindow QTabWidget#graphTabs QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #23364D;
    border: 1px solid #E3E8EE;
    border-bottom: 3px solid #2871B8;
    font-weight: bold;
}

#graphWindow QWidget#graphTabPage {
    background-color: #FFFFFF;
    border-radius: 8px;
}

/* Governing equation educational card */
#graphWindow QLabel#equationHeading {
    color: #23364D;
    font-size: 13px;
    font-weight: bold;
}

#graphWindow QLabel#equationSubheading {
    color: #64748B;
    font-size: 11px;
    font-weight: 600;
}

#graphWindow QWidget#equationCard {
    background-color: #F5F8FB;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
}

#graphWindow QLabel#equationExplanation {
    color: #64748B;
    font-size: 11px;
    font-family: "Segoe UI";
}
